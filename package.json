{
  "name": "hunt-mon",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "smoke": "node scripts/smoke.mjs",
    "smoke:m4": "node scripts/smoke-m4.mjs",
    "app": "npm run build && electron .",
    "dist": "npm run build && electron-builder --win --publish never"
  },
  "dependencies": {
    "@fontsource/press-start-2p": "^5.3.0",
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "playwright-core": "^1.63.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.3"
  },
  "main": "electron/main.cjs",
  "description": "Hunt-mon",
  "author": "swist",
  "build": {
    "appId": "com.huntmon.game",
    "productName": "Hunt-mon",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
