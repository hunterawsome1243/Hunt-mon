{
  "compilerOptions": {
    "target": "ES2020", "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "noUnusedLocals": true, "noUnusedParameters": true,
    "noImplicitReturns": true, "skipLibCheck": true, "lib": ["ES2020","DOM"],
    "types": ["vite/client"], "isolatedModules": true, "noEmit": true
  },
  "include": ["src", "tests"]
}
